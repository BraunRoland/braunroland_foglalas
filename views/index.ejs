<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <div class="row">
            <div class="col-sm-12 text-center">
                <h1>Mozi Foglalás</h1>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12 text-center">
                <h3>Foglalások száma: <%= count %></h3>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6 mx-auto">
                <form method="post" id="form" class="rounded-4">
                    <div>
                        <label for="name" class="form-label">Név: </label>
                        <input 
                            type="text" 
                            class="form-control" 
                            name="name" 
                            id="name"
                            value="<%= locals.name? name : '' %>"
                        >
                        <% if (locals.nameErr) { %>
                           <p class="hiba"><%= nameErr %></p> 
                        <% } %>
                    </div>
                    <div>
                        <label for="email" class="form-label">Email: </label>
                        <input 
                            type="text" 
                            class="form-control" 
                            name="email" 
                            id="email"
                            value="<%= locals.email ? email  : '' %>"
                        >
                        <% if (locals.emailErr) { %>
                           <p class="hiba"><%= emailErr %></p> 
                        <% } %>
                    </div>
                    <div>
                        <label for="date" class="form-label">Dátum: </label>
                        <input 
                            type="datetime-local" 
                            class="form-control" 
                            name="startDate" 
                            id="date"
                            value="<%= locals.startDate ? startDate  : '' %>"
                        >
                        <% if (locals.dateErr) { %>
                           <p class="hiba"><%= dateErr %></p> 
                        <% } %>
                    </div>
                    <div>
                        <label for="guests" class="form-label">Nézők</label>
                        <input 
                            type="number" 
                            class="form-control" 
                            name="guests" 
                            id="guests" 
                            placeholder="1 és 10 között"
                            value="<%= locals.guests ? guests  : '' %>"
                        >
                        <% if (locals.guestsErr) { %>
                           <p class="hiba"><%= guestsErr %></p> 
                        <% } %>
                    </div>
                    <button type="submit" class="btn btn-success">Foglalás</button>
                </form>
            </div>
        </div>
        <% if(locals.postSuccess) { %>
         <div class="row">
            <div class="col-sm-6 mx-auto">
                <div class="alert alert-<%= postSuccess? 'success' : 'danger' %>">
                    <strong><%= postSuccess? 'Siker!' : 'Hiba!' %></strong> <%= postMessage %>
                </div>
            </div>
         </div>   
        <% } %>
    </div>
</body>
</html>